db:
  host: ente-postgres.apps.svc.cluster.local
  port: 5432
  name: ente_db
  user: pguser
  password: REPLACE_WITH_POSTGRES_PASSWORD

s3:
  are_local_buckets: false
  use_path_style_urls: true
  b2-eu-cen:
    key: REPLACE_WITH_MINIO_ROOT_USER
    secret: REPLACE_WITH_MINIO_ROOT_PASSWORD
    endpoint: ente-storage.example.invalid
    region: eu-central-2
    bucket: b2-eu-cen
  wasabi-eu-central-2-v3:
    key: REPLACE_WITH_MINIO_ROOT_USER
    secret: REPLACE_WITH_MINIO_ROOT_PASSWORD
    endpoint: ente-storage.example.invalid
    region: eu-central-2
    bucket: wasabi-eu-central-2-v3
    compliance: false
  scw-eu-fr-v3:
    key: REPLACE_WITH_MINIO_ROOT_USER
    secret: REPLACE_WITH_MINIO_ROOT_PASSWORD
    endpoint: ente-storage.example.invalid
    region: eu-central-2
    bucket: scw-eu-fr-v3

key:
  encryption: REPLACE_WITH_BASE64_32_BYTE_KEY
  hash: REPLACE_WITH_BASE64_64_BYTE_KEY

jwt:
  secret: REPLACE_WITH_BASE64URL_32_BYTE_SECRET
