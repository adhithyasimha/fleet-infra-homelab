apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{ .Name }}
  namespace: {{ .Namespace }}
  annotations:
    traefik.ingress.kubernetes.io/router.entrypoints: websecure
    traefik.ingress.kubernetes.io/router.tls: "true"
spec:
  ingressClassName: {{ .IngressClassName }}
  tls:
    - hosts:
        - {{ .Host }}
      secretName: {{ .Name }}-tls
  rules:
    - host: {{ .Host }}
      http:
        paths:
          - path: {{ .Path }}
            pathType: Prefix
            backend:
              service:
                name: {{ .Service }}
                port:
                  number: {{ .Port }}
